---
import Layout from '../layouts/Layout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

// Service titles double as the contact-form checkbox values so the
// per-service "Get a Quote" buttons can pre-check the matching box.
const services = [
  {
    title: 'Lawn Maintenance',
    image: '/images/service-mowing.webp',
    alt: 'Professional lawn mowing and maintenance service',
    description: 'Regular mowing, trimming, and edging on a schedule that fits your lawn, cut to the right height and kept consistently neat and healthy.',
  },
  {
    title: 'Full-Service Yard Cleanup',
    image: '/images/service-cleanup.webp',
    alt: 'Seasonal full-service yard cleanup',
    description: 'Seasonal leaf and debris removal, bed clearing, and a complete tidy-up to get your whole yard looking sharp.',
  },
  {
    title: 'Landscaping',
    image: '/images/service-edging.webp',
    alt: 'Basic landscaping with mulch, pinestraw, and flowers',
    description: 'Mulch, pinestraw, rock, fresh flowers, and other basic landscaping touch-ups to refresh your beds and borders.',
  },
  {
    title: 'Pressure Washing',
    image: '/images/service-pressure-washing.jpg',
    alt: 'Professional pressure washing service',
    description: 'Blast away dirt, grime, mold, and buildup from driveways, walkways, patios, decks, and siding, leaving every surface looking new.',
  },
  {
    title: 'Roof & Gutter Cleaning',
    image: '/images/service-roof-gutter.jpg',
    alt: 'Roof and gutter cleaning service',
    description: 'Complete roof debris removal plus a full gutter flush that clears moss, leaves, and buildup, protecting your home top to bottom.',
  },
];

// Checkbox options on the quote form (titles match the service titles above).
const serviceOptions = [
  { value: 'Lawn Maintenance', description: 'Mowing, trimming, and edging to keep your lawn neat and healthy.' },
  { value: 'Full-Service Yard Cleanup', description: 'Leaf and debris removal, bed clearing, and a thorough seasonal tidy-up.' },
  { value: 'Landscaping', description: 'Mulch, pinestraw, rock, flowers, and other basic landscaping touch-ups.' },
  { value: 'Pressure Washing', description: 'Driveways, walkways, patios, decks, and siding washed clean.' },
  { value: 'Roof & Gutter Cleaning', description: 'Roof debris removal plus a full gutter flush to protect your home.' },
];

const steps = [
  { icon: 'fa-phone', step: '1', title: 'Call or Request Online', desc: 'Reach out by phone or our quote form.' },
  { icon: 'fa-clipboard-list', step: '2', title: 'Free Assessment', desc: 'We evaluate your property and give a no-obligation quote.' },
  { icon: 'fa-calendar-check', step: '3', title: 'Schedule Your Service', desc: 'Pick a time that works for you.' },
  { icon: 'fa-star', step: '4', title: 'Enjoy Your Property', desc: 'Sit back while we do the work.' },
];

const testimonials = [
  { name: 'JoAnn C.', quote: 'Taylor does amazing work! My yard looks better than it ever has. Highly recommend!' },
  { name: 'Shawn T.', quote: 'Very professional and reliable. My lawn has never looked this good!' },
  { name: 'LaTanya M.', quote: 'Great communication and quality work. Will definitely use again!' },
  { name: 'Chandler G.', quote: 'Showed up on time, did excellent work, and the price was fair.' },
];

const areas = [
  'East Atlanta', 'Decatur', 'Kirkwood', 'Edgewood', 'Candler Park',
  'Little Five Points', 'Reynoldstown', 'Cabbagetown', 'Grant Park',
  'Ormewood Park', 'East Lake', 'Oakhurst', 'Avondale Estates', 'Clarkston',
];

const whyUs = [
  { icon: 'fa-house', title: 'Family-Owned & Local', desc: 'A local business that cares about the community it serves.' },
  { icon: 'fa-calendar', title: 'Reliable & On-Time', desc: 'We show up when we say we will, every single time.' },
  { icon: 'fa-tag', title: 'Affordable Pricing', desc: 'Fair, transparent pricing with no hidden fees.' },
  { icon: 'fa-shield-halved', title: 'Satisfaction Guaranteed', desc: 'Your satisfaction is our top priority on every job.' },
];
---

<Layout
  title="Whiddon Landscaping & Lawn Care LLC: Lawn & Exterior Home Maintenance in Metro Atlanta + Surrounding Areas"
  description="Reliable, affordable lawn maintenance and exterior home upkeep (mowing, cleanups, pressure washing, roof & gutter cleaning, and basic landscaping) in East Atlanta, Decatur, Kirkwood, and surrounding Metro Atlanta areas. Call (470) 443-3344 for a free quote."
>
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center pt-24 md:pt-32 pb-12 overflow-hidden">
    <div class="absolute inset-0 bg-[#071A09] overflow-hidden">
      <div class="mesh-orb orb-green"></div>
      <div class="mesh-orb orb-blue"></div>
      <div class="mesh-orb orb-yellow"></div>
      <img
        src="/images/hero-lawn.webp"
        alt="Beautifully maintained Atlanta lawn at dusk by Whiddon Landscaping"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A]/80 via-[#111111]/60 to-[#0A0A0A]/85"></div>
    <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
      <p class="text-[#F8DA6D] font-heading font-black uppercase tracking-widest text-xl mb-6">Metro Atlanta + Surrounding Areas</p>
      <h1 class="font-heading font-black text-5xl md:text-7xl text-white mb-6 leading-none uppercase tracking-tight">
        Lawn & Home<br/>Maintenance Made Easy
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-xl mx-auto leading-relaxed">
        Reliable, affordable lawn maintenance and exterior home upkeep that keep your property looking its best, year-round.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#contact"
          class="bg-[#F8DA6D] hover:bg-[#fff07a] text-[#111111] font-heading font-black uppercase tracking-widest text-sm px-8 py-4 rounded-full transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+14704433344"
          class="border-2 border-white/60 text-white hover:bg-white/10 font-heading font-bold uppercase tracking-widest text-sm px-8 py-4 rounded-full transition-all duration-200"
        >
          <i class="fa-solid fa-phone mr-2"></i>Call Now
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar - dark -->
  <section class="bg-[#111111] py-12 px-6 border-b border-white/10">
    <div class="max-w-5xl mx-auto text-center reveal">
      <div class="flex justify-center gap-1.5 mb-4">
        {[1,2,3,4,5].map(() => <i class="fa-solid fa-star text-[#F8DA6D] text-xl"></i>)}
      </div>
      <p class="font-heading font-black text-white text-lg mb-6 uppercase tracking-widest">
        Trusted by homeowners across Metro Atlanta + Surrounding Areas
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {['10+ Years Experience', 'Locally Owned & Operated', 'Licensed & Insured'].map(stat => (
          <span class="border-2 border-[#F8DA6D] text-[#F8DA6D] font-heading font-bold uppercase tracking-wide px-5 py-2 rounded-full text-xs">
            {stat}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- About - light -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <p class="text-[#1B8CC4] font-heading font-black uppercase tracking-widest text-xl mb-3">Our Story</p>
        <h2 class="font-heading font-black text-3xl md:text-5xl text-[#111111] mb-6 uppercase tracking-tight leading-none">About Whiddon Landscaping</h2>
        <p class="text-gray-500 leading-relaxed text-lg mb-6">
          Whiddon Landscaping &amp; Lawn Care LLC is a family-owned business focused on lawn maintenance and exterior
          home upkeep across Metro Atlanta + Surrounding Areas. From routine mowing and seasonal cleanups to pressure
          washing and roof &amp; gutter cleaning, plus basic landscaping touch-ups, we keep your lawn and the outside of
          your home clean, tidy, and well-maintained. We're not a full-scale design-and-install landscaping firm; we're
          the dependable crew that handles the everyday upkeep, so you can enjoy your property without the work.
        </p>
        <a href="#services" class="inline-flex items-center gap-2 text-[#1570A6] font-heading font-black uppercase tracking-widest text-xs hover:gap-3 transition-all duration-200">
          See our services <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
      <div class="reveal relative">
        <div class="rounded-2xl overflow-hidden shadow-2xl h-80 md:h-[420px] bg-[#2D7034]">
          <img
            src="/images/about-taylor.jpg"
            alt="Taylor Whiddon, owner of Whiddon Landscaping"
            class="w-full h-full object-cover"
            onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-white font-semibold\'>about-taylor.jpg</div>'"
          />
        </div>

        <!-- Owner callout: blue circle straddling the bottom-right edge + curly arrow pointing at Taylor -->
        <div class="absolute -right-5 -bottom-5 md:-right-6 md:-bottom-6 flex items-end gap-0 z-20">
          <!-- curly looped arrow (white-outlined) pointing up-left toward Taylor -->
          <svg
            class="owner-arrow w-16 h-16 md:w-20 md:h-20 mb-12 md:mb-14 -mr-2 drop-shadow-lg"
            viewBox="0 0 120 120"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <!-- white outline (drawn wider, behind) -->
            <path stroke="#ffffff" stroke-width="13" d="M97,90 C97,103 79,103 79,90 C79,79 93,77 93,90 C93,99 82,101 74,92 C62,79 56,52 46,34 M46,34 l18,2 M46,34 l2,18" />
            <!-- blue arrow on top -->
            <path stroke="#0B639D" stroke-width="7" d="M97,90 C97,103 79,103 79,90 C79,79 93,77 93,90 C93,99 82,101 74,92 C62,79 56,52 46,34 M46,34 l18,2 M46,34 l2,18" />
          </svg>
          <!-- circle badge -->
          <div class="w-28 h-28 md:w-32 md:h-32 rounded-full bg-[#0B639D] shadow-xl ring-4 ring-white/90 flex flex-col items-center justify-center text-center px-3">
            <span class="font-heading font-black text-white uppercase tracking-wide text-xs md:text-sm leading-tight">Taylor Whiddon</span>
            <span class="font-heading font-bold text-[#F8DA6D] uppercase tracking-widest text-[10px] md:text-xs mt-1">Owner</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services - Ricola-style "discover more" cards -->
  <section id="services" class="py-20 px-6 bg-[#F0F9FF] scroll-mt-20">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 reveal">
        <img
          src="/images/whiddon-emblem.svg"
          alt="Whiddon Landscaping emblem"
          class="w-24 h-24 md:w-28 md:h-28 mx-auto mb-6"
          loading="lazy"
        />
        <p class="text-[#1B8CC4] font-heading font-black uppercase tracking-widest text-xl mb-3">What We Offer</p>
        <h2 class="font-heading font-black text-3xl md:text-5xl text-[#111111] mb-4 uppercase tracking-tight leading-none">Discover Our Services</h2>
        <p class="text-gray-500 text-base max-w-2xl mx-auto">Lawn maintenance and exterior home upkeep, done right every time.</p>
        <p class="text-gray-400 text-sm leading-relaxed mt-4 max-w-xl mx-auto">
          We focus on routine upkeep and basic landscaping touch-ups, not full landscape design or installation.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <div class="group flex flex-col reveal">
            <div class="rounded-3xl overflow-hidden aspect-[4/3] bg-[#2D7034] mb-5 shadow-sm">
              <img
                src={service.image}
                alt={service.alt}
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                onerror={`this.parentElement.innerHTML='<div class="w-full h-full flex items-center justify-center text-white font-semibold p-4 text-center">${service.image.split('/').pop()}</div>'`}
              />
            </div>
            <h3 class="font-heading font-black text-xl text-[#111111] mb-2 uppercase tracking-tight">{service.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-5 grow">{service.description}</p>
            <button
              type="button"
              class="service-quote-btn inline-flex items-center gap-2 self-start text-[#1570A6] hover:text-[#1B8CC4] font-heading font-black uppercase tracking-widest text-xs transition-colors duration-200 cursor-pointer"
              data-service={service.title}
            >
              Get a Quote
              <i class="fa-solid fa-arrow-right transition-transform duration-200 group-hover:translate-x-1"></i>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works - dark -->
  <section class="py-20 px-6 bg-[#111111]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14 reveal">
        <p class="text-[#F8DA6D] font-heading font-black uppercase tracking-widest text-xl mb-3">The Process</p>
        <h2 class="font-heading font-black text-3xl md:text-5xl text-white mb-4 uppercase tracking-tight leading-none">How It Works</h2>
        <p class="text-gray-400 text-base">Getting started is simple. Here's what to expect.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {steps.map(step => (
          <div class="text-center reveal">
            <div class="relative inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#EFF6FF] mb-4">
              <i class={`fa-solid ${step.icon} text-[#1B8CC4] text-xl`}></i>
              <span class="absolute -top-1 -right-1 w-6 h-6 bg-[#F8DA6D] rounded-full text-[#0D2B45] text-xs font-bold flex items-center justify-center">
                {step.step}
              </span>
            </div>
            <h3 class="font-heading font-black text-sm text-white mb-2 uppercase tracking-wide">{step.title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials - dark -->
  <section class="py-20 px-6 bg-[#111111] border-t border-white/10">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-[#F8DA6D] font-heading font-black uppercase tracking-widest text-xl mb-3">Don't Take Our Word For It</p>
        <h2 class="font-heading font-black text-3xl md:text-5xl text-white mb-4 uppercase tracking-tight leading-none">What Our Customers Say</h2>
        <p class="text-gray-400 text-base">Real reviews from real homeowners across Metro Atlanta + Surrounding Areas.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {testimonials.map(t => <TestimonialCard name={t.name} quote={t.quote} />)}
      </div>
    </div>
  </section>

  <!-- Service Areas - dark navy with map -->
  <section class="py-20 px-6 bg-[#0D1B2A] relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <iframe
        src="https://www.openstreetmap.org/export/embed.html?bbox=-84.8%2C33.5%2C-84.0%2C33.95&layer=mapnik"
        class="w-full h-full border-0 opacity-[0.07]"
        title="Metro Atlanta service area map"
        loading="lazy"
      ></iframe>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto text-center reveal">
      <p class="text-[#F8DA6D] font-heading font-black uppercase tracking-widest text-xl mb-3">Where We Work</p>
      <h2 class="font-heading font-black text-3xl md:text-5xl text-white mb-4 uppercase tracking-tight leading-none">Serving Metro Atlanta + Surrounding Areas</h2>
      <p class="text-gray-400 text-base mb-10">We proudly serve homeowners across these neighborhoods and beyond.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {areas.map(area => (
          <span class="bg-[#2D7034] hover:bg-[#3d8f44] text-white font-heading font-bold px-5 py-2 rounded-full text-xs uppercase tracking-wide transition-colors duration-200 cursor-default">
            {area}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us - light -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14 reveal">
        <p class="text-[#1B8CC4] font-heading font-black uppercase tracking-widest text-xl mb-3">The Whiddon Difference</p>
        <h2 class="font-heading font-black text-3xl md:text-5xl text-[#111111] mb-4 uppercase tracking-tight leading-none">Why Choose Us?</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {whyUs.map(item => (
          <div class="text-center reveal">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#EFF6FF] mb-4">
              <i class={`fa-solid ${item.icon} text-xl text-[#1B8CC4]`}></i>
            </div>
            <h3 class="font-heading font-black text-sm text-[#111111] mb-2 uppercase tracking-wide">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact / Quote - light -->
  <section id="contact" class="py-20 px-6 bg-[#F0F9FF] scroll-mt-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-[#1B8CC4] font-heading font-black uppercase tracking-widest text-xl mb-3">Free Estimate</p>
        <h2 class="font-heading font-black text-3xl md:text-5xl text-[#111111] mb-4 uppercase tracking-tight leading-none">Get a Free Quote</h2>
        <p class="text-gray-500 text-base">Tell us what you need and we'll get back to you within 24 hours.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <!-- Quote Form -->
        <div class="lg:col-span-3 reveal">
          <!--
            TODO: Mailgun integration needed.
            Replace the action URL with your Mailgun endpoint or a serverless function
            that forwards form submissions to whiddonllc@gmail.com via Mailgun.
            Note: "services" is a multi-value field - read it as an array/list.
          -->
          <form
            id="quote-form"
            action="/api/contact"
            method="POST"
            class="space-y-5"
          >
            <!-- Honeypot spam prevention -->
            <input type="text" name="_gotcha" style="display:none" />

            <div>
              <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">Full Name <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jane Smith"
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-[#1C1C1C] focus:outline-none focus:ring-2 focus:ring-[#1570A6] focus:border-transparent transition-all bg-white"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address <span class="text-red-500">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-[#1C1C1C] focus:outline-none focus:ring-2 focus:ring-[#1570A6] focus:border-transparent transition-all bg-white"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">Phone Number <span class="text-red-500">*</span></label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="(470) 555-0123"
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-[#1C1C1C] focus:outline-none focus:ring-2 focus:ring-[#1570A6] focus:border-transparent transition-all bg-white"
              />
            </div>

            <div>
              <label for="address" class="block text-sm font-semibold text-gray-700 mb-1.5">Service Address <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="address"
                name="address"
                required
                placeholder="123 Main St, Atlanta, GA 30317"
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-[#1C1C1C] focus:outline-none focus:ring-2 focus:ring-[#1570A6] focus:border-transparent transition-all bg-white"
              />
            </div>

            <fieldset>
              <legend class="block text-sm font-semibold text-gray-700 mb-1.5">Services Needed <span class="text-red-500">*</span></legend>
              <p class="text-sm text-gray-500 mb-3">Select all that apply.</p>
              <div class="space-y-3">
                {serviceOptions.map(option => (
                  <label class="flex items-start gap-3 border border-gray-300 rounded-xl px-4 py-3 cursor-pointer transition-all bg-white hover:border-[#1570A6] has-[:checked]:border-[#1570A6] has-[:checked]:bg-[#E0F2FE]">
                    <input
                      type="checkbox"
                      name="services"
                      value={option.value}
                      class="mt-0.5 h-5 w-5 shrink-0 accent-[#1570A6] focus:outline-none focus:ring-2 focus:ring-[#1570A6]"
                    />
                    <span>
                      <span class="block font-semibold text-[#1C1C1C]">{option.value}</span>
                      <span class="block text-sm text-gray-500 leading-relaxed">{option.description}</span>
                    </span>
                  </label>
                ))}
              </div>
              <p id="services-error" class="hidden text-sm text-red-500 mt-2">Please select at least one service.</p>
            </fieldset>

            <div>
              <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">Message / Additional Info</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Tell us about your yard, any specific needs, or questions..."
                class="w-full border border-gray-300 rounded-xl px-4 py-3 text-[#1C1C1C] focus:outline-none focus:ring-2 focus:ring-[#1570A6] focus:border-transparent transition-all resize-none bg-white"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-[#1570A6] hover:bg-[#1B8CC4] text-white font-heading font-bold py-4 rounded-full text-lg transition-all duration-200 shadow-md hover:-translate-y-0.5"
            >
              Send My Request
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <aside class="lg:col-span-2 reveal">
          <div class="bg-white rounded-2xl shadow-sm p-8 sticky top-28">
            <h3 class="font-heading font-bold text-2xl text-[#1C1C1C] mb-6">Contact Info</h3>
            <ul class="space-y-5">
              <li>
                <a href="tel:+14704433344" class="flex items-center gap-4 group">
                  <div class="w-11 h-11 rounded-full bg-[#EFF6FF] flex items-center justify-center shrink-0 group-hover:bg-[#dbeafe] transition-colors">
                    <i class="fa-solid fa-phone text-[#1570A6]"></i>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-0.5">Phone</p>
                    <p class="font-semibold text-[#1C1C1C] group-hover:text-[#1570A6] transition-colors">(470) 443-3344</p>
                  </div>
                </a>
              </li>
              <li>
                <a href="mailto:whiddonllc@gmail.com" class="flex items-center gap-4 group">
                  <div class="w-11 h-11 rounded-full bg-[#EFF6FF] flex items-center justify-center shrink-0 group-hover:bg-[#dbeafe] transition-colors">
                    <i class="fa-solid fa-envelope text-[#1570A6]"></i>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-0.5">Email</p>
