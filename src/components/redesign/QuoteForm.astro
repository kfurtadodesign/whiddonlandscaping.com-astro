---
import { services } from '../../data/services';

const contactRows = [
  { label: 'Phone', value: '(470) 443-3344', href: 'tel:+14704433344' },
  { label: 'Email', value: 'whiddonllc@gmail.com', href: 'mailto:whiddonllc@gmail.com' },
  { label: 'Hours', value: 'Mon–Sat · 7am–6pm', href: null },
];

const fields: { id: string; name: string; label: string; type: 'text' | 'email' | 'tel'; placeholder: string }[] = [
  { id: 'name', name: 'name', label: 'Full Name', type: 'text', placeholder: 'Jane Doe' },
  { id: 'email', name: 'email', label: 'Email Address', type: 'email', placeholder: 'jane@example.com' },
  { id: 'phone', name: 'phone', label: 'Phone Number', type: 'tel', placeholder: '(470) 555-0123' },
  { id: 'address', name: 'address', label: 'Service Address', type: 'text', placeholder: '123 Main St, Atlanta' },
];
---

<section id="contact" class="bg-brand-ink py-32 px-6 scroll-mt-24">
  <div class="max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">
    <!-- Left: pitch + contact rows -->
    <div>
      <p class="text-brand-yellow font-heading font-black text-lg tracking-[0.25em] uppercase mb-5">
        Free Estimate
      </p>
      <h2
        class="font-heading font-black text-white uppercase text-[clamp(48px,7vw,112px)] leading-[0.88] tracking-[-0.035em] mb-6"
      >
        Get a<br />Free <span class="text-brand-yellow">Quote</span>
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed max-w-[460px] mb-10">
        Tell us what you need and we'll get back to you within 24 hours.
      </p>

      <dl class="border-t border-white/[0.12]">
        {contactRows.map(row => (
          <div
            class="flex items-center justify-between gap-6 py-[22px] border-b border-white/[0.12]"
          >
            <dt class="text-gray-400 text-xs tracking-[0.2em] uppercase">{row.label}</dt>
            <dd class="font-heading font-black text-white text-right">
              {row.href ? (
                <a href={row.href} class="hover:text-brand-yellow transition-colors duration-200">
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Right: form card -->
    <div class="wl-form bg-white rounded-3xl p-10">
      <form id="wl-quote-form" action="/api/contact" method="POST" novalidate={false}>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6">
          {fields.map(field => (
            <div>
              <label
                for={field.id}
                class="block font-heading font-extrabold text-[11px] tracking-[0.18em] uppercase text-brand-ink mb-2"
              >
                {field.label} <span class="text-brand-green">*</span>
              </label>
              <input
                type={field.type}
                id={field.id}
                name={field.name}
                required
                placeholder={field.placeholder}
                class="w-full border border-gray-300 rounded-xl px-4 py-3.5 text-[15px] text-brand-charcoal bg-white focus:outline-none focus:border-transparent focus:ring-2 focus:ring-brand-blue transition-all"
              />
            </div>
          ))}
        </div>

        <!-- Service chips -->
        <fieldset class="mb-6">
          <legend
            class="font-heading font-extrabold text-[11px] tracking-[0.18em] uppercase text-brand-ink mb-1"
          >
            Services Needed <span class="text-brand-green">*</span>
          </legend>
          <p class="text-gray-500 text-[13px] mb-3">Select all that apply.</p>
          <div class="flex flex-wrap gap-2.5">
            {services.map(service => (
              <label
                class="wl-chip inline-flex items-center gap-2 cursor-pointer select-none bg-white border border-gray-300 text-brand-charcoal font-heading font-bold text-[13px] px-4 py-2.5 rounded-full transition-colors duration-200 has-checked:bg-brand-green has-checked:border-brand-green has-checked:text-white"
              >
                <input
                  type="checkbox"
                  name="services"
                  value={service.title}
                  class="wl-chip-input sr-only"
                />
                <i class="wl-chip-icon fa-solid fa-plus text-[11px]"></i>
                {service.title}
              </label>
            ))}
          </div>
          <p id="wl-service-error" class="hidden mt-3 text-[13px] text-red-700">
            Please select at least one service.
          </p>
        </fieldset>

        <div class="mb-6">
          <label
            for="message"
            class="block font-heading font-extrabold text-[11px] tracking-[0.18em] uppercase text-brand-ink mb-2"
          >
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Lot size, gate code, anything we should know…"
            class="w-full border border-gray-300 rounded-xl px-4 py-3.5 text-[15px] text-brand-charcoal bg-white focus:outline-none focus:border-transparent focus:ring-2 focus:ring-brand-blue transition-all"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-3 bg-brand-yellow hover:bg-brand-yellow-lt text-brand-ink font-heading font-black text-sm tracking-[0.2em] uppercase px-8 py-5 rounded-full transition-all duration-200 hover:-translate-y-0.5 cursor-pointer"
        >
          Send My Request <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <!-- Success state -->
      <div id="wl-quote-success" class="hidden text-center py-6">
        <span
          class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-green mb-6"
        >
          <i class="fa-solid fa-check text-white text-2xl"></i>
        </span>
        <h3
          class="font-heading font-black text-brand-ink uppercase text-4xl tracking-[-0.03em] mb-4"
        >
          Request Received.
        </h3>
        <p class="text-gray-500 text-base leading-relaxed max-w-[380px] mx-auto mb-6">
          Thanks! We'll get back to you within 24 hours. Need us sooner? Call
          <a href="tel:+14704433344" class="text-brand-blue font-bold">(470) 443-3344</a>.
        </p>
        <button
          type="button"
          id="wl-send-another"
          class="inline-flex items-center gap-2 text-brand-blue font-heading font-black text-[13px] tracking-[0.2em] uppercase hover:gap-3 transition-all duration-200 cursor-pointer"
        >
          Send Another <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('wl-quote-form') as HTMLFormElement | null;
  const success = document.getElementById('wl-quote-success');
  const error = document.getElementById('wl-service-error');
  const sendAnother = document.getElementById('wl-send-another');
  const chips = Array.from(document.querySelectorAll<HTMLInputElement>('.wl-chip-input'));

  // Swap the chip's plus for a check when selected, and clear the error.
  chips.forEach(chip => {
    chip.addEventListener('change', () => {
      const icon = chip.parentElement?.querySelector<HTMLElement>('.wl-chip-icon');
      if (icon) {
        icon.className = chip.checked
          ? 'wl-chip-icon fa-solid fa-check text-[11px]'
          : 'wl-chip-icon fa-solid fa-plus text-[11px]';
      }
      if (chip.checked) error?.classList.add('hidden');
    });
  });

  form?.addEventListener('submit', event => {
    if (!chips.some(c => c.checked)) {
      event.preventDefault();
      error?.classList.remove('hidden');
      return;
    }
    // TODO: the Mailgun endpoint at /api/contact does not exist yet — the old
    // homepage has the same gap. Showing the success state keeps the prototype
    // reviewable; remove this preventDefault once the endpoint is live.
    event.preventDefault();
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });

  sendAnother?.addEventListener('click', () => {
    form?.reset();
    chips.forEach(chip => {
      const icon = chip.parentElement?.querySelector<HTMLElement>('.wl-chip-icon');
      if (icon) icon.className = 'wl-chip-icon fa-solid fa-plus text-[11px]';
    });
    success?.classList.add('hidden');
    form?.classList.remove('hidden');
  });

  // Let a "Get a Quote" click elsewhere on the page pre-select a service chip.
  document.querySelectorAll<HTMLElement>('[data-service]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const wanted = trigger.dataset.service;
      const chip = chips.find(c => c.value === wanted);
      if (chip && !chip.checked) {
        chip.checked = true;
        chip.dispatchEvent(new Event('change'));
      }
    });
  });
</script>
