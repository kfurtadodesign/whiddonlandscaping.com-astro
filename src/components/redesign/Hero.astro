---
---

<section
  id="top"
  class="relative min-h-screen flex flex-col justify-end overflow-hidden pt-40 px-6 pb-12"
>
  <!-- Layers, back to front: forest base -> mesh orbs -> photo -> scrim -->
  <div class="absolute inset-0 bg-brand-forest overflow-hidden">
    <div class="mesh-orb orb-green"></div>
    <div class="mesh-orb orb-blue"></div>
    <div class="mesh-orb orb-yellow"></div>
    <img
      src="/images/hero-lawn.webp"
      alt="Beautifully maintained Atlanta lawn at dusk by Whiddon Landscaping"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,10,10,0.75)_0%,rgba(17,17,17,0.35)_40%,rgba(10,10,10,0.92)_100%)]"
  >
  </div>

  <div class="relative z-10 w-full max-w-[1280px] mx-auto">
    <!-- Eyebrow -->
    <div class="flex items-center gap-3 mb-7">
      <span class="block w-10 h-0.5 bg-brand-yellow shrink-0"></span>
      <p class="text-brand-yellow font-heading font-black text-sm tracking-[0.25em] uppercase">
        Metro Atlanta + Surrounding Areas
      </p>
    </div>

    <h1
      class="font-heading font-black text-white uppercase text-[clamp(40px,10.5vw,168px)] leading-[0.88] tracking-[-0.035em] mb-9"
    >
      Lawn &amp; Home<br />
      <span class="text-transparent [-webkit-text-stroke:2px_#fff]">Maintenance</span><br />
      Made <span class="text-brand-yellow">Easy.</span>
    </h1>

    <div class="flex flex-wrap gap-3 mb-12">
      <a
        href="#contact"
        class="inline-flex items-center gap-3 bg-brand-yellow hover:bg-brand-yellow-lt text-brand-ink font-heading font-black text-sm tracking-[0.2em] uppercase px-8 py-5 rounded-full shadow-[0_10px_30px_rgba(248,218,109,0.25)] transition-all duration-200 hover:-translate-y-0.5"
      >
        Get a Free Quote <i class="fa-solid fa-arrow-right"></i>
      </a>
      <a
        href="tel:+14704433344"
        class="inline-flex items-center gap-3 border-2 border-white/60 text-white hover:bg-white/10 font-heading font-black text-sm tracking-[0.2em] uppercase px-[30px] py-[18px] rounded-full transition-all duration-200"
      >
        <i class="fa-solid fa-phone"></i>(470) 443-3344
      </a>
    </div>

    <!-- Bottom bar: lede + trust pills -->
    <div class="border-t border-white/15 pt-8 flex flex-wrap justify-between gap-x-12 gap-y-6">
      <p class="flex-[1_1_420px] max-w-[620px] text-gray-300 text-lg leading-relaxed">
        Reliable, affordable lawn maintenance and exterior home upkeep that keep your property
        looking its best, year-round.
      </p>
      <div class="flex flex-wrap items-start gap-2">
        {['10+ Years Experience', 'Locally Owned', 'Licensed & Insured'].map(pill => (
          <span
            class="border-2 border-brand-yellow text-brand-yellow font-heading font-bold text-[11px] tracking-[0.12em] uppercase px-4 py-2 rounded-full"
          >
            {pill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
