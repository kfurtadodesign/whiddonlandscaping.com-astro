---
// Stats are unconfirmed by the client — see design_handoff README section 4.
const stats = [
  { value: '10', suffix: '+', label: 'Years experience' },
  { value: '14', suffix: '', label: 'Neighborhoods served' },
  { value: '24', suffix: 'h', label: 'Quote response' },
  { value: '6', suffix: 'd', label: 'Days a week, 7am–6pm' },
];
---

<section id="about" class="bg-white py-32 px-6 scroll-mt-24">
  <div class="max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left: copy -->
      <div class="reveal">
        <p
          class="text-brand-blue-vivid font-heading font-black text-lg tracking-[0.25em] uppercase mb-5"
        >
          Our Story
        </p>
        <h2
          class="font-heading font-black uppercase text-brand-ink text-[clamp(36px,4.6vw,68px)] leading-[0.92] tracking-[-0.03em] mb-8"
        >
          The Dependable Crew for the <span class="text-brand-green">Everyday Upkeep.</span>
        </h2>
        <div class="max-w-[560px] space-y-5 mb-8">
          <p class="text-gray-500 text-[17px] leading-[1.7]">
            Whiddon Landscaping &amp; Lawn Care LLC is a family-owned business focused on lawn
            maintenance and exterior home upkeep across Metro Atlanta + Surrounding Areas.
          </p>
          <p class="text-gray-500 text-[17px] leading-[1.7]">
            From routine mowing and seasonal cleanups to pressure washing and roof &amp; gutter
            cleaning, we keep your lawn and the outside of your home clean, tidy, and
            well-maintained — so you can enjoy your property without the work.
          </p>
        </div>
        <a
          href="#services"
          class="group inline-flex items-center gap-2.5 hover:gap-4 text-brand-blue font-heading font-black text-[13px] tracking-[0.2em] uppercase transition-all duration-200"
        >
          See our services <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <!-- Right: portrait + owner badge -->
      <div class="reveal relative lg:justify-self-end w-full max-w-[520px]">
        <div class="rounded-3xl overflow-hidden aspect-[4/5] bg-brand-green">
          <img
            src="/images/about-taylor.jpg"
            alt="Taylor Whiddon, owner of Whiddon Landscaping"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="absolute left-0 bottom-8 flex items-center gap-4 bg-brand-ink rounded-full pl-3 pr-7 py-3 shadow-[0_20px_40px_rgba(0,0,0,0.25)]"
        >
          <span
            class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-yellow shrink-0"
          >
            <i class="fa-solid fa-leaf text-brand-ink"></i>
          </span>
          <span class="block">
            <span class="block text-white font-heading font-black text-[15px] leading-tight"
              >Taylor Whiddon</span
            >
            <span class="block text-gray-400 text-xs tracking-[0.2em] uppercase mt-0.5">Owner</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="mt-28 pt-10 border-t-2 border-brand-ink grid grid-cols-2 lg:grid-cols-4 gap-10">
      {stats.map(stat => (
        <div class="reveal">
          <p
            class="font-heading font-black text-brand-ink text-[clamp(48px,6vw,88px)] leading-none tracking-[-0.04em]"
          >
            {stat.value}<span class="text-brand-blue-vivid">{stat.suffix}</span>
          </p>
          <p
            class="mt-2 text-gray-500 font-heading font-extrabold text-xs tracking-[0.12em] uppercase"
          >
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
